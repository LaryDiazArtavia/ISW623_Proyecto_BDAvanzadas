      },
      "query": "SELECT\n    ruta,\n    COUNT(*) AS total_vuelos,\n    SUM(pasajeros) AS total_pasajeros,\n    ROUND(\n        SUM(pasajeros) * 100.0 / SUM(capacidad),\n        2\n    ) AS ocupacion_porcentaje\nFROM dashboard_pruebas.vuelos\nWHERE 1 = 1\n[[AND {{ruta}}]]\n[[AND {{fecha}}]]\nGROUP BY ruta\nORDER BY ocupacion_porcentaje DESC;\n"
    }
  },
