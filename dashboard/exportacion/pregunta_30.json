      "query": "SELECT\n    clima,\n    COUNT(*) AS total_vuelos,\n    ROUND(AVG(retraso_minutos), 2) AS retraso_promedio\nFROM dashboard_pruebas.vuelos\nWHERE 1 = 1\n[[AND {{ruta}}]]\n[[AND {{fecha}}]]\nGROUP BY clima\nORDER BY retraso_promedio DESC;\n"
    }
